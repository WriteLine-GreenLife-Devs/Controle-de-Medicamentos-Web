@using ControleDeMedicamentosWeb.WebApp.Modulos.ModuloEstoque.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Registrar Saída de Estoque";
}

@model CadastrarSaidaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="CadastrarSaida"
      method="post">
    <div class="mb-3">
        <label asp-for="Data" class="form-label">Data</label>
        <input asp-for="Data" type="date" class="form-control" />
        <span asp-validation-for="Data" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PacienteId" class="form-label">Paciente</label>
        <select asp-for="PacienteId" class="form-select"></select>
        <span asp-validation-for="PacienteId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Medicamentos</label>
        <div id="medicamentos-list">
            <div id="medicamentos-list"></div>
            <button type="button" class="btn btn-outline-primary" onclick="adicionarMedicamento()">Adicionar
                Medicamento</button>

                <script>
                            function adicionarMedicamento() {
                            const container = document.getElementById("medicamentos-list");

                            const div = document.createElement("div");
                            div.classList.add("mb-2");

                        div.innerHTML = `
                            <select name="Medicamentos[index].MedicamentoId" class="form-select">
                            <!-- opções de medicamentos -->
                                </select>
                                <input name="Medicamentos[index].Quantidade" type="number" class="form-control mt-1" placeholder="Quantidade" />
                            `;
                            container.appendChild(div);
                        }
                </script>

            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
            <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
        </div>
    </form>