@using ControleDeMedicamentosWeb.WebApp.Modulos.ModuloEstoque.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Estoque";
}

@model ExcluirEstoqueViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden">

    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Deseja realmente excluir este registro de estoque?
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">ID</dt>
        <dd class="col-sm-8 text-break">@Model.Id</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Data</dt>
        <dd class="col-sm-8">@Model.Data.ToShortDateString()</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Tipo</dt>
        <dd class="col-sm-8">@Model.TipoOperacao</dd>

        @if (Model.TipoOperacao == "Entrada")
        {
            <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Medicamento</dt>
            <dd class="col-sm-8">@Model.Medicamento</dd>

            <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Funcionário</dt>
            <dd class="col-sm-8">@Model.Funcionario</dd>

            <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Quantidade</dt>
            <dd class="col-sm-8">@Model.Quantidade</dd>
        }
        else if (Model.TipoOperacao == "Saída")
        {
            <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Paciente</dt>
            <dd class="col-sm-8">@Model.Paciente</dd>

            <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Medicamentos</dt>
            <dd class="col-sm-8">@string.Join(", ", Model.Medicamentos)</dd>

            <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Quantidade Total</dt>
            <dd class="col-sm-8">@Model.Quantidade</dd>
        }
    </dl>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary" type="submit">Confirmar</button>
    </div>
</form>