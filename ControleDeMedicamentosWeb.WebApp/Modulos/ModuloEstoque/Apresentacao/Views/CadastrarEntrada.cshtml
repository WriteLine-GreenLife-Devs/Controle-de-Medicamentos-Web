@using ControleDeMedicamentosWeb.WebApp.Modulos.ModuloEstoque.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Registrar Entrada de Estoque";
}

@model CadastrarEntradaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="CadastrarEntrada" method="post">
    <div class="mb-3">
        <label asp-for="Data" class="form-label">Data</label>
        <input asp-for="Data" type="date" class="form-control" />
        <span asp-validation-for="Data" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MedicamentoId" class="form-label">Medicamento</label>
        <select asp-for="MedicamentoId" class="form-select"></select>
        <span asp-validation-for="MedicamentoId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FuncionarioId" class="form-label">Funcionário</label>
        <select asp-for="FuncionarioId" class="form-select"></select>
        <span asp-validation-for="FuncionarioId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantidade" class="form-label">Quantidade</label>
        <input asp-for="Quantidade" type="number" class="form-control" />
        <span asp-validation-for="Quantidade" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>