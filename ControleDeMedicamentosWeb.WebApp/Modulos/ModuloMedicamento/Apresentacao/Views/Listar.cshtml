@using ControleDeMedicamentosWeb.WebApp.Modulos.ModuloMedicamento.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Medicamentos";
}

@model List<ListarMedicamentosViewModel>;


<a class="btn-cadastrar-novo" asp-action="Cadastrar">Cadastrar Novo</a>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Nenhum medicamento cadastrado.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="registros">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Descricao</th>
                    <th>Quantidade</th>
                    <th>Fornecedor</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (ListarMedicamentosViewModel p in Model)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.nome</td>
                        <td>@p.descricao</td>
                        <td>@p.quantidade</td>
                        <td>@p.fornecedorNome</td>
                        <td>
                            <a asp-action="Editar" asp-route-id="@p.Id">Editar</a>
                            <a asp-action="Excluir" asp-route-id="@p.Id">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
