@using ControleDeMedicamentosWeb.WebApp.Modulos.ModuloMedicamento.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Medicamentos";
}

@model List<ListarMedicamentosViewModel>;

<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">Cadastrar Novo</a>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Nenhum medicamento cadastrado.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (ListarMedicamentosViewModel p in Model)
        {
            bool emFalta = p.quantidade < 20;
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <h5 class="card-title mb-0 text-truncate">@p.nome</h5>
                            <span class="badge text-bg-primary rounded-pill">@p.Id.ToString().Substring(0, 8)</span>
                        </div>

                        <p class="card-text text-secondary mb-3 text-break">@p.descricao</p>

                        <dl class="row g-2 mb-4">
                            <dt class="col-6 text-secondary fw-semibold">Quantidade</dt>
                            <dd class="col-6 mb-0">
                                @p.quantidade
                                @if (emFalta)
                                {
                                    <span class="badge bg-danger ms-2">Em falta</span>
                                }
                            </dd>

                            <dt class="col-6 text-secondary fw-semibold">Fornecedor</dt>
                            <dd class="col-6 mb-0 text-break">@p.fornecedorNome</dd>
                        </dl>

                        <div class="mt-auto d-flex flex-wrap gap-2 justify-content-end">
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Editar" asp-route-id="@p.Id">Editar</a>
                            <a class="btn btn-outline-danger btn-sm rounded-pill px-3" asp-action="Excluir" asp-route-id="@p.Id">Excluir</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
