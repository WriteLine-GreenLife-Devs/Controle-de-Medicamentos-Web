@using ControleDeMedicamentosWeb.WebApp.Modulos.ModuloMedicamento.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Medicamento";
}

@model EditarMedicamentoViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Editar" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden">

     <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
        <input asp-for="Nome" type="text" class="form-control">
        <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descricao" class="form-label fw-semibold text-primary text-uppercase small">Descrição</label>
        <input asp-for="Descricao" type="text" class="form-control">
        <span asp-validation-for="Descricao" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="quantidade" class="form-label fw-semibold text-primary text-uppercase small">Quantidade</label>
        <input asp-for="quantidade" type="number" class="form-control">
        <span asp-validation-for="quantidade" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Fornecedores" class="form-label fw-semibold text-primary text-uppercase small">Fornecedor</label>
        <select asp-for="Fornecedores" class="form-select">
            <option value="">Selecione um fornecedor</option>
            @foreach (OpcaoFornecedorViewModel fornecedor in Model.Fornecedores)
            {
                <option value="@fornecedor.Id">@fornecedor.nome</option>
            }
        </select>
        <span asp-validation-for="Fornecedores" class="text-danger small fw-semibold"></span>
    </div>

     <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        @if (Model.Fornecedores.Count == 0)
        {
            <button class="btn btn-primary rounded-pill px-4" type="submit" disabled>Confirmar</button>
        }
        else
        {
            <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
        }
    </div>
</form>
