@using ControleDeMedicamentosWeb.WebApp
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Listas de Compras";
}

@model List<ListarFornecedoresViewModel>;

<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">Cadastrar Novo</a>

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
        @mensagemErro
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Nenhum fornecedor cadastrado.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-2">
        @foreach (ListarFornecedoresViewModel f in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <h5 class="card-title mb-0">@f.Nome</h5>
                        </div>

                        <dl class="row g-2 mb-4">
                            @*<dt class="col-6 text-secondary fw-semibold">Criada em</dt>
                            <dd class="col-6 mb-0 text-break">@f.email</dd> *@

                            <dt class="col-6 text-secondary fw-semibold">Telefone</dt>
                            <dd class="col-6 mb-0 text-break">@Servico.FormatarTelefone(f.Telefone)</dd>

                            <dt class="col-6 text-secondary fw-semibold">CNPJ</dt>
                            <dd class="col-6 mb-0 text-break">@Servico.FormatarCNPJ(f.CNPJ)</dd>
                        </dl>

                        <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Editar"
                           asp-route-id="@f.Id">Editar</a>
                        <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Excluir"
                           asp-route-id="@f.Id">Excluir</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

